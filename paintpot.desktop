[Desktop Entry]
Type=Application
Name=Paintpot
Comment=A fast, friendly, pixel-perfect paint program
Exec=paintpot %f
Icon=applications-graphics
Terminal=false
StartupWMClass=paintpot
Categories=Graphics;2DGraphics;RasterGraphics;
MimeType=image/png;image/bmp;image/jpeg;image/gif;image/tiff;image/webp;image/x-icon;
